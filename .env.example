# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://dynamic_agentic:CHANGE_ME@localhost:54329/dynamic_agentic
POSTGRES_DB=dynamic_agentic
POSTGRES_USER=dynamic_agentic
POSTGRES_PASSWORD=CHANGE_ME

# Comma-separated, explicit origins/hosts. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# disabled is the safe local default. test is forbidden outside test environments.
AUTH_MODE=disabled
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# Managed AI services use Application Default Credentials server-side.
AI_PROVIDER_MODE=managed
GOOGLE_CLOUD_PROJECT=CHANGE_ME
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_GEMINI_LOCATION=global
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_EMBEDDING_DIMENSION=768
VERTEX_GEMINI_MODEL=gemini-3.5-flash
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX=dynamic-agentic-rag
PINECONE_INDEX_HOST=
EXTERNAL_CALL_TIMEOUT_SECONDS=30
EXTERNAL_CALL_MAX_ATTEMPTS=3

# Optional future adapters remain unavailable until configured server-side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Generate a Fernet key for staging/production. Local/test derives a local-only key.
DATA_SOURCE_ENCRYPTION_KEY=
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_QUERY_ROW_LIMIT=100
# Explicit database egress allowlist; add approved connector hosts deliberately.
DATA_SOURCE_ALLOWED_HOSTS=localhost,127.0.0.1,postgres

MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=200
MAX_DOCUMENT_CHUNKS=5000
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=240
RAG_TOP_K=6
RAG_CONTEXT_MAX_CHARS=18000
LOCAL_STORAGE_ROOT=.data/objects

# AI Lab workloads are isolated, bounded, and CPU-oriented.
LAB_ARTIFACT_ROOT=.data/lab-artifacts
LAB_MAX_DATASET_ROWS=5000
LAB_MAX_EPOCHS=30
LAB_MAX_RUNTIME_SECONDS=30
LAB_MAX_CONCURRENT_EXPERIMENTS=2
TRANSFORMER_MODEL=prajjwal1/bert-tiny
TRANSFORMER_ALLOW_DOWNLOAD=false

# Public browser configuration only; never place credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
