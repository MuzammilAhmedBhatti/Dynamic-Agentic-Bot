# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://dynamic_agentic:CHANGE_ME@localhost:54329/dynamic_agentic
POSTGRES_DB=dynamic_agentic
POSTGRES_USER=dynamic_agentic
POSTGRES_PASSWORD=CHANGE_ME

# Comma-separated, explicit origins/hosts. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# disabled is the safe local default. test is forbidden outside test environments.
# oidc requires OIDC_ISSUER_URL and OIDC_CLIENT_ID.
AUTH_MODE=disabled
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# Managed AI services. Google uses Application Default Credentials; never put a
# service-account JSON document in this file or in browser configuration.
AI_PROVIDER_MODE=managed
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIMENSION=768
VERTEX_GEMINI_MODEL=gemini-2.5-flash
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=
EXTERNAL_CALL_TIMEOUT_SECONDS=30
EXTERNAL_CALL_MAX_ATTEMPTS=3

# Development policy defaults; production values remain configurable.
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=200
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=240
RAG_TOP_K=6
RAG_CONTEXT_MAX_CHARS=18000
LOCAL_STORAGE_ROOT=.data/objects

# Public browser configuration only; never place credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
